# =============================================================================
# Conversion Engine — Secrets Template
# Copy to .env and fill in. All secrets live here; tunables live in config.yaml.
# See __specs/18-configuration.md.
# =============================================================================

# --- Kill-switch (belt + braces; MUST also set config.yaml:killswitch.enabled=true
#     to actually send to real recipients). Default unset routes to local sink.
CONVERGINE_ENABLE_REAL_OUTBOUND=0
CONVERGINE_ENV=local

# --- LLM providers (OpenRouter covers dev-tier; Anthropic/OpenAI for eval-tier)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# If unset, the harness/orchestrator use the built-in deterministic mock LLM.
CONVERGINE_LLM_MODE=mock   # mock | live

# --- Email (primary channel)
RESEND_API_KEY=
RESEND_FROM_DOMAIN=convergine-sandbox.invalid
RESEND_FROM_ADDRESS=outbound@convergine-sandbox.invalid
RESEND_WEBHOOK_SECRET=

# Alternate provider (fallback)
MAILERSEND_API_KEY=

# --- SMS (secondary, warm-lead scheduling)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SHORTCODE=22222
AFRICASTALKING_WEBHOOK_SECRET=

# --- HubSpot sandbox (CRM)
HUBSPOT_MCP_URL=http://localhost:4000
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Cal.com (self-hosted)
CALCOM_BASE_URL=http://localhost:3000
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# --- Observability
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=convergine-local

# --- Enrichment (optional)
BUILTWITH_API_KEY=

# --- Voice rig (bonus only, out of scope for interim)
VOICE_RIG_WEBHOOK_URL=
VOICE_RIG_KEYWORD_PREFIX=
