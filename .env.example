# =============================================================================
# Conversion Engine — .env template
# =============================================================================
# Copy this file to `.env` at the repo root. NEVER commit `.env`.
# Every variable below is either a secret (API key, webhook secret) or an
# environment-specific endpoint. Operational knobs (thresholds, weights,
# prices) live in config.yaml, not here.
#
# Fail-fast rule: if a required variable is missing, the process refuses to
# start. The required-vs-optional status is noted inline.
# =============================================================================


# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENV=dev                                  # dev | staging | prod (required)
LOG_LEVEL=INFO                           # DEBUG | INFO | WARN | ERROR


# -----------------------------------------------------------------------------
# Eval-tier & sealed-partition guards
# -----------------------------------------------------------------------------
# DEFAULT: UNSET. Dual-guard the eval-tier model budget against accidental
# burn on dev-slice runs. See __specs/11-tau2-bench-harness.md.
#
# EVAL_TIER_ENABLED=1
# TAU2_SEALED_ACCESS=1


# -----------------------------------------------------------------------------
# LLM providers (required)
# -----------------------------------------------------------------------------
# Dev-tier LLM — used for Acts I–III, mechanism prototyping.
OPENROUTER_API_KEY=                      # required
OPENROUTER_BASE_URL=
DEV_LLM_MODEL=
DEV_LLM_FALLBACK_MODELS=

# Eval-tier LLM — sealed held-out scoring only.
ANTHROPIC_API_KEY=                       # required if EVAL_LLM_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=                          # required if EVAL_LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
EVAL_LLM_PROVIDER=anthropic              # anthropic | openai
EVAL_LLM_MODEL=claude-sonnet-4-6         # or gpt-5

# Optional: smaller cheaper models for tone check and reply classification.
TONE_CHECK_MODEL=                        # falls back to DEV_LLM_MODEL if unset
REPLY_CLASSIFIER_MODEL=                  # falls back to DEV_LLM_MODEL if unset


# -----------------------------------------------------------------------------
# Email (Resend or MailerSend free tier) — required
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend                    # resend | mailersend
RESEND_API_KEY=                          # required if EMAIL_PROVIDER=resend
RESEND_WEBHOOK_SECRET=                   # HMAC secret for reply webhook
RESEND_FROM_ADDRESS=research@<configured-domain>
RESEND_WEBHOOK_URL=https://<ngrok-or-tunnel>/webhook/email
MAILERSEND_API_KEY=                      # required if EMAIL_PROVIDER=mailersend

# Staff sink — where outbound goes when kill switch is unset (required).
EMAIL_SINK_ADDRESS=
EMAIL_DEFAULT_REPLY_TO=


# -----------------------------------------------------------------------------
# SMS (Africa's Talking sandbox) — required for Act II warm-lead scheduling
# -----------------------------------------------------------------------------
AT_API_KEY=
AT_USERNAME=sandbox
AT_SHORT_CODE=                           # virtual short code, program-provisioned
AT_WEBHOOK_URL=https://<ngrok-or-tunnel>/webhook/sms
AT_WEBHOOK_SECRET=

SMS_SINK_NUMBER=                         # staff-controlled sink number


# -----------------------------------------------------------------------------
# Voice (Shared Voice Rig) — optional, bonus tier
# -----------------------------------------------------------------------------
VOICE_RIG_BASE_URL=
VOICE_RIG_WEBHOOK_URL=https://<ngrok-or-tunnel>/webhook/voice
VOICE_RIG_KEYWORD_PREFIX=                # per-trainee prefix
VOICE_RIG_WEBHOOK_SECRET=
VOICE_SINK_NUMBER=


# -----------------------------------------------------------------------------
# HubSpot Developer Sandbox (MCP server) — required
# -----------------------------------------------------------------------------
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_MCP_SERVER_URL=http://localhost:8001
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_APP_ID=
HUBSPOT_PORTAL_ID=                       # Developer Sandbox portal (NOT production)
HUBSPOT_OWNER_ID_DEFAULT=
HUBSPOT_DEAL_PIPELINE_ID=


# -----------------------------------------------------------------------------
# Cal.com (self-hosted) — required
# -----------------------------------------------------------------------------
CALCOM_BASE_URL=http://localhost:3000
CALCOM_API_KEY=
CALCOM_USERNAME=
CALCOM_EVENT_TYPE_DISCOVERY_15=discovery-15
CALCOM_EVENT_TYPE_DISCOVERY_30=discovery-30
CALCOM_WEBHOOK_URL=https://<ngrok-or-tunnel>/webhook/cal
CALCOM_WEBHOOK_SECRET=
CALCOM_DEFAULT_DURATION_MINUTES=15
CALCOM_DEFAULT_DELIVERY_LEAD=arun@<configured-domain>


# -----------------------------------------------------------------------------
# Langfuse (cloud free tier) — required
# -----------------------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_TRACE_PREFIX=


# -----------------------------------------------------------------------------
# Data sources (required for Act II enrichment)
# -----------------------------------------------------------------------------
CRUNCHBASE_ODM_URL=https://github.com/luminati-io/Crunchbase-dataset-samples
CRUNCHBASE_ODM_LOCAL_PATH=data/crunchbase_odm_sample.json

LAYOFFS_FYI_URL=https://layoffs.fyi/data.csv
LAYOFFS_FYI_LOCAL_PATH=data/layoffs_fyi_2026_q1.csv

BUILTIN_BASE_URL=https://builtin.com
WELLFOUND_BASE_URL=https://wellfound.com
LINKEDIN_JOBS_BASE_URL=https://www.linkedin.com/jobs

JOB_POSTS_SNAPSHOT_PATH=data/job_posts_snapshot_2026-04-01.json


# -----------------------------------------------------------------------------
# τ²-Bench — required
# -----------------------------------------------------------------------------
TAU2_BENCH_REPO_URL=https://github.com/sierra-research/tau2-bench
TAU2_LOCAL_PATH=eval/tau2
TAU2_HELDOUT_PATH=../tau2_sealed_heldout   # OUTSIDE the repo tree


# -----------------------------------------------------------------------------
# Scraper user agent (policy-mandated)
# -----------------------------------------------------------------------------
SCRAPER_USER_AGENT=TRP1-Week10-Research (trainee@trp1.example)


# -----------------------------------------------------------------------------
# Kill-switch runtime strictness
# -----------------------------------------------------------------------------
KILL_SWITCH_STRICT=strict                # strict | warn (default: strict)
