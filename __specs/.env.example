# =============================================================================
# Conversion Engine — Environment Variables Template
# =============================================================================
# Copy to `.env` at repo root. `.env` MUST be gitignored.
# Fill in values. Leave optional keys blank when not used.
# Boot validates required keys; missing keys abort startup.
# See __specs/18-configuration.md for the full loader contract.
# =============================================================================

# -----------------------------------------------------------------------------
# [1] LLM providers
# -----------------------------------------------------------------------------
# Dev-tier (Days 1–4): Qwen3-Next-80B-A3B OR DeepSeek V3.2 via OpenRouter.
# Target <$4 spend. Always required.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Eval-tier (Days 5–7): only used by `make held-out`. Optional for interim submission.
# Pick one — Anthropic (Claude Sonnet 4.6) OR OpenAI (GPT-5 class).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# [2] Email (primary channel) — Resend
# -----------------------------------------------------------------------------
# Resend free tier: 3000 emails/month, no credit card.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_DOMAIN=convergine-sandbox.example.com
RESEND_FROM_ADDRESS=outbound@convergine-sandbox.example.com

# -----------------------------------------------------------------------------
# [3] SMS (secondary channel, warm-lead scheduling) — Africa's Talking sandbox
# -----------------------------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AFRICASTALKING_SHORTCODE=22222
AFRICASTALKING_KEYWORD_PREFIX=CV-01
AFRICASTALKING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# [4] Voice (bonus) — Tenacious Shared Voice Rig
# -----------------------------------------------------------------------------
# Only needed if you attempt the voice bonus. Program-operated rig.
VOICE_RIG_WEBHOOK_URL=
VOICE_RIG_KEYWORD_PREFIX=

# -----------------------------------------------------------------------------
# [5] CRM — HubSpot Developer Sandbox (free, MCP, 100 req/10s)
# -----------------------------------------------------------------------------
HUBSPOT_MCP_URL=http://localhost:7070/mcp
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUBSPOT_PORTAL_ID=

# -----------------------------------------------------------------------------
# [6] Calendar — Cal.com self-hosted (Docker Compose)
# -----------------------------------------------------------------------------
CALCOM_BASE_URL=http://localhost:3000
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CALCOM_WEBHOOK_SECRET=cal_webhook_secret_xxxxxxxxxxxxxxxxxxxxxx
CALCOM_DB_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# [7] Observability — Langfuse cloud (free tier)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT=convergine-trainee-01

# -----------------------------------------------------------------------------
# [8] Enrichment helpers (optional — improve coverage; absence degrades gracefully)
# -----------------------------------------------------------------------------
BUILTWITH_API_KEY=
WAPPALYZER_API_KEY=
GITHUB_READ_ONLY_TOKEN=

# Crunchbase ODM sample ships as a local JSON file (Apache 2.0). No key required.
# Layoffs.fyi CSV ships as a local snapshot (CC-BY). No key required.

# -----------------------------------------------------------------------------
# [9] Kill-switch — DEFAULT UNSET (routes all outbound to staff sink)
# -----------------------------------------------------------------------------
# DO NOT FLIP TO 1 WITHOUT:
#   - Program staff confirmation in writing
#   - README entry documenting date + operator + scope
#   - AND also setting config.yaml → killswitch.enabled: true
# Belt + braces: both flags required to route to real recipients.
CONVERGINE_ENABLE_REAL_OUTBOUND=0

# -----------------------------------------------------------------------------
# [10] Environment + misc
# -----------------------------------------------------------------------------
CONVERGINE_ENV=local          # local | ci | eval
CONVERGINE_LOG_LEVEL=INFO     # DEBUG | INFO | WARN | ERROR
CONVERGINE_GIT_SHA=           # auto-populated by CI; blank in dev
