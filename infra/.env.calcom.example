NEXTAUTH_SECRET=<replace_me_with_a_long_random_string>
CALENDSO_ENCRYPTION_KEY=<replace_me_with_a_32_char_string>
CRON_API_KEY=<replace_me_with_a_random_string>

# Generate all three safely with:
#   NEXTAUTH_SECRET=$(openssl rand -base64 32)
#   CALENDSO_ENCRYPTION_KEY=$(openssl rand -hex 16)     # exactly 32 hex chars
#   CRON_API_KEY=$(openssl rand -base64 32)
#
# IMPORTANT: strip the < > angle brackets when you paste real values;
# Cal.com's config parser treats them as literal characters.
